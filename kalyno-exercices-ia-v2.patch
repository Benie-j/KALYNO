+@Composable
+private fun InfoBox(
+    title: String,
+    icon: String,
+    container: Color,
+    accent: Color,
+    modifier: Modifier = Modifier,
+    bordered: Boolean = false,
+    content: @Composable ColumnScope.() -> Unit
+) {
+    val shape = RoundedCornerShape(18.dp)
+    Column(
+        modifier = modifier
+            .fillMaxWidth()
+            .clip(shape)
+            .background(container)
+            .then(if (bordered) Modifier.border(1.dp, KalynoOutline, shape) else Modifier)
+            .padding(15.dp),
+        verticalArrangement = Arrangement.spacedBy(10.dp)
+    ) {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            KalynoSvgIcon(name = icon, size = 16.dp, tint = accent)
+            Spacer(Modifier.width(8.dp))
+            Text(
+                text = title,
+                color = accent,
+                fontSize = 11.sp,
+                fontWeight = FontWeight.ExtraBold,
+                letterSpacing = 0.6.sp
+            )
+        }
+        content()
+    }
+}
+
+@Composable
+private fun BulletLine(icon: String, tint: Color, text: String, textColor: Color) {
+    Row(verticalAlignment = Alignment.Top) {
+        Box(modifier = Modifier.padding(top = 3.dp)) {
+            KalynoSvgIcon(name = icon, size = 14.dp, tint = tint)
+        }
+        Spacer(Modifier.width(8.dp))
+        Text(
+            text = text,
+            color = textColor,
+            fontSize = 14.sp,
+            lineHeight = 20.sp,
+            modifier = Modifier.weight(1f)
+        )
+    }
+}
