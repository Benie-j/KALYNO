+/** Trois points qui rebondissent : « l'IA réfléchit ». */
+@Composable
+private fun ThinkingDots(color: Color = KalynoBlue) {
+    val transition = rememberInfiniteTransition(label = "dots")
+    Row(
+        horizontalArrangement = Arrangement.spacedBy(5.dp),
+        verticalAlignment = Alignment.CenterVertically
+    ) {
+        for (i in 0..2) {
+            val lift by transition.animateFloat(
+                initialValue = 0f,
+                targetValue = 1f,
+                animationSpec = infiniteRepeatable(
+                    animation = tween(durationMillis = 520),
+                    repeatMode = RepeatMode.Reverse,
+                    initialStartOffset = StartOffset(i * 160)
+                ),
+                label = "dot$i"
+            )
+            Box(
+                modifier = Modifier
+                    .size(8.dp)
+                    .graphicsLayer {
+                        translationY = -lift * 5.dp.toPx()
+                        alpha = 0.45f + 0.55f * lift
+                    }
+                    .clip(CircleShape)
+                    .background(color)
+            )
+        }
+    }
+}
+
+@Composable
+private fun rememberSpin(): Float {
+    val transition = rememberInfiniteTransition(label = "spin")
+    val angle by transition.animateFloat(
+        initialValue = 0f,
+        targetValue = 360f,
+        animationSpec = infiniteRepeatable(tween(durationMillis = 900, easing = LinearEasing)),
+        label = "spinAngle"
+    )
+    return angle
+}
