-- KALYNO : Classe/Série > Discipline > Thème > Leçon, avec Tle A1 et Tle A2 distinctes.
-- À coller dans Supabase > SQL Editor. Script rejouable (idempotent).
-- L'app reste fonctionnelle même si ce script n'est pas encore passé : elle retombe sur l'ancien rendu.

begin;

-- 1) Classes / séries : groupe d'examen, icône vectorielle, courte description ---------------------
alter table public.levels
  add column if not exists cycle    text,
  add column if not exists icon_key text,
  add column if not exists tagline  text;

-- Tle A est scindée en deux séries aux programmes différents (positions : ordre d'affichage).
insert into public.levels (id, label, position, is_active, cycle, icon_key)
values
  ('TLE_A1', 'Tle A1', 20, true, 'BAC', 'pen-line'),
  ('TLE_A2', 'Tle A2', 30, true, 'BAC', 'globe')
on conflict (id) do update
  set label = excluded.label,
      position = excluded.position,
      is_active = true,
      cycle = excluded.cycle,
      icon_key = excluded.icon_key;

update public.levels set cycle = 'BEPC', icon_key = 'backpack',      position = 10 where id = '3E';
update public.levels set cycle = 'BAC',  icon_key = 'calculator',    position = 40 where id = 'TLE_C';
update public.levels set cycle = 'BAC',  icon_key = 'flask-conical', position = 50 where id = 'TLE_D';

-- L'ancienne série unique n'est plus proposée aux élèves.
update public.levels set position = 60 where id = 'TLE_A';

-- Description facultative affichée sous le nom de la série (à remplir par l'équipe pédagogique), ex. :
-- update public.levels set tagline = '...' where id = 'TLE_A1';

-- 2) Icône des disciplines (remplace la colonne emoji, qui n'est plus lue par l'app) ------------------
alter table public.subjects add column if not exists icon_key text;
-- Clés disponibles : backpack, graduation-cap, book-open, pen-line, calculator, flask-conical,
-- globe, brain, layers, target, lightbulb, rocket, trophy, dumbbell
-- Exemple : update public.subjects set icon_key = 'calculator' where name ilike 'math%';

-- 3) Thèmes (chapitres globaux) -----------------------------------------------------------------------
-- Le type de subject_id suit celui de subjects.id (uuid ou text), pour que la clé étrangère passe.
do $$
declare
  id_type text;
begin
  select format_type(a.atttypid, a.atttypmod) into id_type
  from pg_attribute a
  where a.attrelid = 'public.subjects'::regclass and a.attname = 'id' and not a.attisdropped;

  execute format($f$
    create table if not exists public.themes (
      id         uuid primary key default gen_random_uuid(),
      subject_id %s not null references public.subjects(id) on delete cascade,
      title      text not null,
      position   integer not null default 0,
      status     text not null default 'draft' check (status in ('draft', 'published')),
      created_at timestamptz not null default now()
    )
  $f$, id_type);
end $$;

create index if not exists themes_subject_idx on public.themes (subject_id, position);

-- 4) Rattacher les leçons (table chapters) à un thème ------------------------------------------------
alter table public.chapters
  add column if not exists theme_id uuid references public.themes(id) on delete set null;

create index if not exists chapters_theme_idx on public.chapters (theme_id);

-- 5) Sécurité : lecture publique des thèmes publiés, écriture réservée à l'admin connecté ---------
-- (adapte ces deux politiques si tes autres tables utilisent une règle d'admin plus stricte)
alter table public.themes enable row level security;

drop policy if exists themes_read_published on public.themes;
create policy themes_read_published on public.themes
  for select using (status = 'published');

drop policy if exists themes_admin_all on public.themes;
create policy themes_admin_all on public.themes
  for all to authenticated using (public.is_admin()) with check (public.is_admin());

commit;

-- 6) À FAIRE À LA MAIN, une fois que tu sais quel contenu va dans quelle série ----------------------
-- Les disciplines/leçons/défis qui étaient rattachés à TLE_A ne sont plus visibles.
-- Si tout ce contenu correspond à Tle A1 :
--   update public.subjects   set level_id = 'TLE_A1' where level_id = 'TLE_A';
--   update public.challenges set level_id = 'TLE_A1' where level_id = 'TLE_A';
-- Tle A2 a un programme différent : ses disciplines et son défi de découverte se créent depuis l'admin.
