+            val done = list.count { it.isFinished() }
+            Column(modifier = Modifier.entrance(index = groupIndex)) {
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Box(
+                        modifier = Modifier
+                            .size(36.dp)
